# =========================================================================
# FPEL Credit Check - environment configuration
# Copy this file to ".env" in the same folder and fill in real values.
# The app loads it automatically at startup via python-dotenv.
# NEVER commit your real .env to git.
# =========================================================================

# ---- Flask -------------------------------------------------------------
# Used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-long-random-hex-string
FLASK_ENV=development
FLASK_DEBUG=true
IS_PRODUCTION=false

# Local default is SQLite at ./instance/fpel_credit_check.db (auto-created).
# Uncomment & override if you want a different path or Postgres in prod.
# DATABASE_URL=sqlite:///fpel_credit_check.db

# Session cookie hardening. Keep SECURE=false locally (HTTP), true in prod (HTTPS).
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_HTTPONLY=true

# ---- RBAC defaults ------------------------------------------------------
# Super admin is hard-coded; cannot be demoted.
SUPER_ADMIN_EMAIL=ai@fourthpartner.co

# Comma-separated list of users who should be admin by default.
DEFAULT_ADMIN_EMAILS=vaidehi.sridhar@fourthpartner.co

# Optional: restrict sign-in to a single email domain. Leave blank to allow any.
ALLOWED_EMAIL_DOMAIN=fourthpartner.co

# ---- Microsoft Entra ID (Azure AD) app registration ---------------------
# https://entra.microsoft.com -> Applications -> App registrations -> + New
# Redirect URI (Web):
#   http://localhost:5000/auth/callback         (local dev)
#   https://<your-prod-host>/auth/callback      (production)
MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_SECRET=your-client-secret-value-here
MICROSOFT_AUTHORITY=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000
MICROSOFT_GRAPH_SCOPE=https://graph.microsoft.com/.default

# ---- Microsoft Graph - test email button --------------------------------
# Mailbox the app SENDS test mails as. Must be a real licensed mailbox.
# Azure AD app needs APPLICATION permission "Mail.Send" + admin consent.
GRAPH_SENDER_UPN=noreply@fourthpartner.co

# ---- D365 Finance & Operations (OData) ----------------------------------
# These power the "Sync from D365" button on the dashboard, which pulls
# records from the FPELDetailBases entity (with ResponsiblePerson resolved
# via the Employees entity).
#
# The service principal used here needs:
#   - API permission: Dynamics ERP -> Connect to Dynamics 365 / OData
#   - Inside D365: System administration -> Setup -> Azure Active Directory
#     applications -> add the same Client ID, mapped to a user with rights
#     to read FPELDetailBases and Employees.
#
# You can reuse the MICROSOFT_* app registration ONLY if it has been granted
# the D365 permissions above. Otherwise create a second app registration.
D365_TENANT_ID=4a7e4853-bf49-4e09-85e4-2976b4c1b096
D365_CLIENT_ID=
D365_CLIENT_SECRET=
D365_BASE_URL=https://uat4pel.sandbox.operations.dynamics.com
# Optional - leave blank for cross-company. Otherwise set to the company code
# (DataAreaId) you want to scope queries to.
D365_COMPANY=
# Optional overrides - defaults match the entity names in the docs.
D365_CASES_ENTITY=FPELDetailBases
D365_EMPLOYEES_ENTITY=Employees

# ---- Legacy SMTP (NOT used by the current app) --------------------------
# The app sends mail via Microsoft Graph only. Keep these commented unless
# you re-introduce an SMTP fallback. Storing a password here is a security risk.
# MAIL_SERVER=smtp.office365.com
# MAIL_PORT=587
# MAIL_USERNAME=ai@fourthpartner.co
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=AI FPEL <ai@fourthpartner.co>
